@model List<library.Models.LoanView>

@{
    ViewData["Title"] = "Loans";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Loans</h1>
        <p class="text-muted mb-0">Library borrowing records</p>
    </div>

    <a asp-action="Borrow" class="btn btn-primary">
        + Borrow a book
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No loan records found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Loaned On</th>
                    <th>Days Allowed</th>
                    <th>Returned On</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.MemberName</td>
                        <td>@loan.BookTitle</td>
                        <td>@loan.LoanedOn</td>
                        <td>@loan.DaysAllowed</td>
                        <td>@(loan.ReturnedOn?.ToString() ?? "Not returned")</td>
                        <td>
                            @if (loan.Status == "Out")
                            {
                                <span class="badge bg-primary">Out</span>
                            }
                            else if (loan.Status == "Overdue")
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Returned</span>
                            }
                        </td>
                        <td>
                            @* Task 9 puts the Return button here *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
