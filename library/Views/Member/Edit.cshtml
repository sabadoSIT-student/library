@model library.Models.Member
@{
    ViewData["Title"] = "Edit a member";
}
<h1 class="mb-3">Edit a member</h1>
<form asp-action="Edit" method="post" class="card card-body" style="max-width:36rem">
    <!-- Hidden input to keep track of the ID being edited -->
    <input type="hidden" asp-for="MemberId" />
    <!-- Full Name Field -->
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <!-- Email Field -->
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <!-- Member Type Dropdown -->
    <div class="mb-3">
        <label asp-for="MemberType" class="form-label"></label>
        <select asp-for="MemberType" class="form-select">
            <option value="">(none)</option>
            <option>Regular</option>
            <option>Premium</option>
            <option>Student</option>
        </select>
        <span asp-validation-for="MemberType" class="text-danger"></span>
    </div>
    <!-- Action Buttons -->
    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>