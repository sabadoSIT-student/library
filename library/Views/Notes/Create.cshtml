@model Note
@{
    ViewData["Title"] = "Add a note";
}
<h1 class="mb-3">Add a note</h1>
<form asp-action="Create" method="post" class="card card-body" style="max-width:36rem">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder= />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <!-- Replaced book dropdown with a text area block for writing notes -->
        <textarea asp-for="Body" class="form-control" rows="6" placeholder="Write your note here..."></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>